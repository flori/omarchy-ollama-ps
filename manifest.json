{
  "$schema": "https://raw.githubusercontent.com/omarchy/omarchy/main/schemas/plugin.json",
  "schemaVersion": 1,
  "id": "flori.ollama-ps",
  "name": "Ollama PS",
  "version": "1.0.2",
  "author": "flori",
  "license": "MIT",
  "description": "Ollama server state and loaded models for the Omarchy bar",
  "kinds": ["service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Ollama PS",
    "description": "Ollama server state and loaded models",
    "category": "System",
    "defaultSection": "center",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 15,
      "maxDisplayedModels": 12,
      "compactMode": false
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "maxDisplayedModels",
        "type": "integer",
        "label": "Maximum displayed models",
        "min": 1,
        "step": 1,
        "defaultValue": 12
      },
      {
        "key": "compactMode",
        "type": "boolean",
        "label": "Compact mode",
        "defaultValue": false
      },
      {
        "key": "servers",
        "type": "object",
        "label": "Servers (name → URL map)",
        "defaultValue": {}
      }
    ]
  }
}
